        if 2 <= len(name) <= 100 and norm_identity(name) not in {"this", "there", "here", "place", "restaurant", "at"}:
            return name, basis, confidence

    # Parenthetical addresses: choose the final proper-noun sequence before the opening parenthesis.
    before_parenthesis = prefix.rsplit("(", 1)[0] if "(" in prefix else prefix
    candidates = _titlecase_name_candidates(before_parenthesis[-160:])
    if candidates:
        name = cleanup_name(candidates[-1])
        name = re.sub(r"^(?:At|In|On|From|Half a mile north at|Around the corner from)\s+", "", name, flags=re.I)
        if 2 <= len(name) <= 90 and norm_identity(name) not in {"this", "there", "here", "place", "restaurant", "new york"}:
            return name, "nearest proper-noun phrase before parenthetical address", 0.91

    # Generic address-only metadata can be associated through a specific slug/title only
    # when that name is independently present in the direct article corpus.
    if specific_title(title) and norm_identity(title) in norm_identity(corpus):
        return cleanup_name(title), "specific source headline corroborated by article corpus", 0.93
    slug = slug_name(source_url)
    if slug and len(norm_identity(slug).split()) <= 8 and norm_identity(slug) in norm_identity(corpus):
        return cleanup_name(slug), "source URL slug corroborated by article corpus", 0.92

    # Last strong proper-noun phrase immediately before the address.
    candidates = _titlecase_name_candidates(prefix[-180:])
    if candidates:
        name = cleanup_name(candidates[-1])
        name = re.sub(r"^(?:At|In|On|The|A|An)\s+", "", name, flags=re.I)
        if 2 <= len(name) <= 90 and not ADDRESS_CUE_RE.search(name) and norm_identity(name) not in {"this", "there", "here", "place", "restaurant"}:
            return name, "nearest proper-noun phrase in same source block", 0.82

    return "", "venue name could not be associated with the address in the source block", 0.0


def _locality_hint(text: str, address: str) -> str:
    joined = f"{address} {text}"
    m = _V2_WORLD_CITIES.search(joined)
    if m:
        city = m.group(1)
        if city.lower() in {"brooklyn", "queens", "bronx", "manhattan", "staten island"}:
            return f"{city}, New York, United States"
        if city.lower() == "new york":
            return "New York, NY, United States"
        return city
    if re.search(r"\b(?:NY|New York|Brooklyn|Queens|Bronx|Manhattan|Staten Island)\b", address, re.I):
        return "New York, NY, United States"
    # Tables for Two is historically New York-centric; use this only as a query hint,
    # never as published evidence unless Maps returns the same street/building.
    if re.search(rf"\b(?:{_V2_FULL_SUFFIX}|{_V2_ABBR_SUFFIX}\.?|Broadway|Bowery)\b", address, re.I):
        return "New York, NY, United States"
    return ""


