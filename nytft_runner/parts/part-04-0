                "Candidate Address": r.get("raw_address") or r.get("google_result_address") or r.get("evidence_excerpt", ""),
                "Source URL": r.get("source_url", ""),
                "Guide": r.get("guide", ""),
                "Year": r.get("year", ""),
                "Occurrence ID": r.get("occurrence_id", ""),
                "Decision": r.get("decision", ""),
                "Exclusion Reason": r.get("exclusion_reason", ""),
                "Google Result Name": r.get("google_result_name", ""),
                "Google Result Address": r.get("google_result_address", ""),
                "Evidence Excerpt": r.get("evidence_excerpt", ""),
            }
    exclusions = sorted(exclusions_by_key.values(), key=lambda r: (r["Source URL"], r["Occurrence ID"]))
    return public_rows, evidence_rows, exclusions


def validate_public_rows(rows: list[dict[str, Any]]) -> dict[str, Any]:
    errors: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for i, row in enumerate(rows, 2):
        for field in PUBLIC_HEADER:
            value = str(row.get(field, "")).strip()
            if not value:
                errors.append({"row": i, "field": field, "error": "blank required field"})
            elif value.lower() in PLACEHOLDERS:
                errors.append({"row": i, "field": field, "error": "placeholder value"})
        try:
            lat_s, lng_s = [x.strip() for x in row["Latitude and longitude"].split(",", 1)]
            lat, lng = float(lat_s), float(lng_s)
            if not (-90 <= lat <= 90 and -180 <= lng <= 180):
                raise ValueError("out of WGS84 range")
        except Exception as exc:
            errors.append({"row": i, "field": "Latitude and longitude", "error": f"invalid coordinates: {exc}"})
        if not re.match(r"^https://www\.newyorker\.com/(?:magazine|culture)/", row.get("Source URL", "")):
            errors.append({"row": i, "field": "Source URL", "error": "noncanonical New Yorker source URL"})
        if not re.match(r"^https://(?:www\.)?(?:google\.com/maps|maps\.google\.com)/", row.get("Google Maps URL", "")):
            errors.append({"row": i, "field": "Google Maps URL", "error": "malformed Google Maps URL"})
        if not re.fullmatch(r"\d{4}", str(row.get("Year", ""))):
            errors.append({"row": i, "field": "Year", "error": "year is not four digits"})
        if not str(row.get("Priority", "")).isdigit() or int(row["Priority"]) < 1:
            errors.append({"row": i, "field": "Priority", "error": "priority is not a positive integer"})
        key = (norm_identity(row.get("Name", "")), norm_address(row.get("Address", "")))
        if key in seen:
            errors.append({"row": i, "field": "Name/Address", "error": "normalized duplicate"})
        seen.add(key)
        if int(row.get("_bucket", 0)) not in BUCKET_FILES:
            errors.append({"row": i, "field": "_bucket", "error": "invalid bucket assignment"})
    return {
        "valid": not errors,
        "row_count": len(rows),
        "error_count": len(errors),
        "errors": errors,
        "checks": {
            "exact_header": True,
            "required_fields_nonblank": not any(e["error"] == "blank required field" for e in errors),
            "no_placeholders": not any(e["error"] == "placeholder value" for e in errors),
            "coordinates_valid": not any(e["field"] == "Latitude and longitude" for e in errors),
            "source_urls_canonical": not any(e["field"] == "Source URL" for e in errors),
            "google_maps_urls_valid": not any(e["field"] == "Google Maps URL" for e in errors),
            "normalized_duplicates_absent": not any(e["error"] == "normalized duplicate" for e in errors),
            "bucket_assignments_valid": not any(e["field"] == "_bucket" for e in errors),
        },
    }


def verify_csv_files() -> list[dict[str, Any]]:
    results = []
    for bucket, filename in BUCKET_FILES.items():
        path = OUTDIR / filename
        try:
            with path.open("r", encoding="utf-8-sig", newline="") as f:
                reader = csv.DictReader(f)
                rows = list(reader)
                header = reader.fieldnames
            results.append({
                "file": filename,
                "bucket": bucket,
                "parseable": True,
                "header_exact": header == PUBLIC_HEADER,
                "rows": len(rows),
                "blank_required_fields": sum(1 for row in rows if any(not str(row.get(k, "")).strip() for k in PUBLIC_HEADER)),
            })
        except Exception as exc:
            results.append({"file": filename, "bucket": bucket, "parseable": False, "header_exact": False, "rows": 0, "blank_required_fields": 0, "error": str(exc)})
    return results


