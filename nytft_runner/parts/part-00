def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def normalize_space(value: Any) -> str:
    return re.sub(r"\s+", " ", html_lib.unescape(str(value or ""))).strip()


def ascii_fold(value: Any) -> str:
    return "".join(c for c in unicodedata.normalize("NFKD", str(value or "")) if not unicodedata.combining(c))


def norm_identity(value: Any) -> str:
    s = ascii_fold(value).lower().replace("&", " and ")
    s = re.sub(r"[^a-z0-9]+", " ", s)
    return " ".join(t for t in s.split() if t not in NAME_STOPWORDS)


def norm_address(value: Any) -> str:
    s = f" {ascii_fold(value).lower()} "
    replacements = {
        " street ": " st ", " avenue ": " ave ", " road ": " rd ",
        " boulevard ": " blvd ", " place ": " pl ", " drive ": " dr ",
        " lane ": " ln ", " court ": " ct ", " terrace ": " ter ",
        " parkway ": " pkwy ", " highway ": " hwy ",
        " new york city ": " new york ", " united states of america ": " united states ",
    }
    for a, b in replacements.items():
        s = s.replace(a, b)
    return " ".join(re.sub(r"[^a-z0-9]+", " ", s).split())


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def stable_id(*parts: Any) -> str:
    raw = "\x1f".join(str(p or "") for p in parts)
    return hashlib.sha1(raw.encode("utf-8", "ignore")).hexdigest()[:16]


def truncate_words(text: str, max_words: int = 28) -> str:
    words = normalize_space(text).split()
    if len(words) <= max_words:
        return " ".join(words)
    return " ".join(words[:max_words]) + " …"


def canonicalize_newyorker_url(url: str) -> str:
    if not url:
        return ""
    if url.startswith("/"):
        url = urllib.parse.urljoin("https://www.newyorker.com", url)
    p = urllib.parse.urlparse(url)
    path = p.path.rstrip("/")
    if "%issue%" in path:
        path = path.replace("%issue%", "%25issue%25")
    return urllib.parse.urlunparse(("https", "www.newyorker.com", path, "", "", ""))


@dataclasses.dataclass
class FetchRecord:
    requested_url: str
    final_url: str
    status: int
    attempts: int
    redirected: bool
    content_type: str
    bytes: int
    error: str
    fetched_at: str
    purpose: str
    elapsed_ms: int


class HostRateLimiter:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.last: dict[str, float] = {}

    def wait(self, url: str, delay: float) -> None:
        host = urllib.parse.urlparse(url).netloc.lower()
        with self.lock:
            elapsed = time.monotonic() - self.last.get(host, 0.0)
            if elapsed < delay:
                time.sleep(delay - elapsed)
            self.last[host] = time.monotonic()


class Fetcher:
    def __init__(self) -> None:
        self.rate = HostRateLimiter()
        self.records: list[FetchRecord] = []
        self.records_lock = threading.Lock()
        self.local = threading.local()

    def session(self) -> requests.Session:
        if not hasattr(self.local, "session"):
            s = requests.Session()
            retries = Retry(
                total=0, connect=0, read=0, redirect=3,
                status_forcelist=[], allowed_methods=frozenset(["GET", "HEAD"]),
            )
            s.mount("https://", HTTPAdapter(max_retries=retries, pool_connections=20, pool_maxsize=20))
            s.headers.update({
                "User-Agent": USER_AGENT,
                "Accept-Language": "en-US,en;q=0.9",
                "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,application/json;q=0.8,*/*;q=0.7",
            })
            self.local.session = s
        return self.local.session

    def get(
        self,
        url: str,
        purpose: str,
        *,
        delay: float | None = None,
        timeout: float | None = None,
        headers: dict[str, str] | None = None,
    ) -> requests.Response | None:
        delay = NY_DELAY if delay is None else delay
        timeout = REQUEST_TIMEOUT if timeout is None else timeout
        last_error = ""
        response: requests.Response | None = None
        started = time.monotonic()
        for attempt in range(1, MAX_RETRIES + 1):
            self.rate.wait(url, delay)
            try:
                response = self.session().get(url, timeout=timeout, allow_redirects=True, headers=headers)
                if response.status_code in {408, 425, 429, 500, 502, 503, 504} and attempt < MAX_RETRIES:
                    retry_after = response.headers.get("Retry-After", "")
                    pause = float(retry_after) if retry_after.isdigit() else min(45.0, 2.0 ** attempt + random.random())
                    time.sleep(pause)
                    continue
                break
            except Exception as exc:
                last_error = f"{type(exc).__name__}: {exc}"
                if attempt < MAX_RETRIES:
                    time.sleep(min(30.0, 2.0 ** attempt + random.random()))
        elapsed_ms = int((time.monotonic() - started) * 1000)
        if response is None:
            rec = FetchRecord(url, "", 0, MAX_RETRIES, False, "", 0, last_error, now_iso(), purpose, elapsed_ms)
        else:
            rec = FetchRecord(
                url, response.url, response.status_code, attempt,
                response.url.rstrip("/") != url.rstrip("/"), response.headers.get("content-type", ""),
                len(response.content), last_error, now_iso(), purpose, elapsed_ms,
            )
        with self.records_lock:
            self.records.append(rec)
        return response


