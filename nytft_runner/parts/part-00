    main = soup.find("main") or soup
    links: list[str] = []
    card_blocks = main.find_all(["article", "li"], recursive=True)
    for a in main.find_all("a", href=True):
        href = html_lib.unescape(a.get("href", "")).split("#", 1)[0]
        if href.startswith("/"):
            href = urllib.parse.urljoin("https://www.newyorker.com", href)
        p = urllib.parse.urlparse(href)
        if p.netloc not in {"www.newyorker.com", "newyorker.com"}:
            continue
